      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum((wifi_station_signal_dbm{job=\"openwrt-monitoring\",instance=\"$instance\"} < bool -70) or (wifi_station_inactive_milliseconds{job=\"openwrt-monitoring\",instance=\"$instance\"} > bool 60000))",
