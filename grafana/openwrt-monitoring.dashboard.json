              {
                "id": "displayName",
                "value": "Inactive (s)"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 120
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "RX Rate (kbps)"
              },
              {
                "id": "unit",
                "value": "Kbits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TX Rate (kbps)"
              },
              {
                "id": "unit",
                "value": "Kbits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ifname"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Radio"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mac"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "MAC"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 12,
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "wifi_station_signal_dbm{job=\"openwrt-monitoring\",instance=\"$instance\"}",
