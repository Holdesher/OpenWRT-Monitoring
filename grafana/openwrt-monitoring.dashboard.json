        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Signal"
              },
              {
                "id": "unit",
                "value": "dBm"
              },
              {
                "id": "min",
                "value": -100
              },
              {
                "id": "max",
                "value": -30
