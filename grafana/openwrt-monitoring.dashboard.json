            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "mac",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Radio 1": true,
              "Radio 2": true,
              "Radio 3": true,
              "Time": true,
              "__name__": true,
              "ifname 1": true,
              "ifname 2": true,
              "ifname 3": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "ifname": 1,
              "mac": 0
            }
          }
