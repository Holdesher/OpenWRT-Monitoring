    {
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "description": "Monitors packet drops across all interfaces except loopback. Investigate if drops > 0 pkt/s.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1e-06
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 39
