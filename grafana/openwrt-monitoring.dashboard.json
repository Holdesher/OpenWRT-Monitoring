    {
      "id": 16,
      "title": "CPU Usage (5m, %)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(irate(node_cpu_seconds_total{mode=\"system\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(irate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy System"
        },
        {
          "refId": "B",
          "expr": "100 * sum(irate(node_cpu_seconds_total{mode=\"user\",job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])) / clamp_min(sum(irate(node_cpu_seconds_total{job=\"openwrt-monitoring\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "Busy User"
        },
