    {
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "description": "Live per-client Wi-Fi activity with signal quality and inactivity timers.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Signal (dBm)"
              },
              {
                "id": "unit",
                "value": "dBm"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": -75
                    },
                    {
                      "color": "green",
                      "value": -70
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
