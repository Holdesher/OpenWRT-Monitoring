    {
      "datasource": {
        "type": "prometheus",
        "uid": "dfjz2m1e86xogb"
      },
      "description": "Per-device activity and quality: signal, idle time, throughput, and issue score.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Signal dBm"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dBm"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": -70
                    },
                    {
                      "color": "green",
                      "value": -65
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Idle s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "red",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RX kbps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Kbits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TX kbps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Kbits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total kbps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Kbits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Issue Score"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 4
      },
      "id": 12,
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "wifi_station_signal_dbm{job=\"openwrt-monitoring\",instance=\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max by (mac, instance, job) (wifi_station_inactive_milliseconds{job=\"openwrt-monitoring\",instance=\"$instance\"}) / 1000",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max by (mac, instance, job) (wifi_station_receive_kilobits_per_second{job=\"openwrt-monitoring\",instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "max by (mac, instance, job) (wifi_station_transmit_kilobits_per_second{job=\"openwrt-monitoring\",instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "(wifi_station_signal_dbm{job=\"openwrt-monitoring\",instance=\"$instance\"} < bool -70) + on(mac, instance, job) (max by (mac, instance, job) (wifi_station_inactive_milliseconds{job=\"openwrt-monitoring\",instance=\"$instance\"}) / 1000 > bool 60)",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ],
      "title": "Connected Devices Activity",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "mac",
            "mode": "inner"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Value #C",
              "operator": "+",
              "right": "Value #D"
            },
            "alias": "Total kbps",
            "replaceFields": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value #E",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Radio 1": true,
              "Radio 2": true,
              "Radio 3": true,
              "Time": true,
              "__name__": true,
              "ifname 1": true,
              "ifname 2": true,
              "ifname 3": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "mac": 0,
              "ip": 1,
              "ipaddr": 2,
              "hostname": 3,
              "name": 4,
              "ifname": 5,
              "Value #A": 6,
              "Value #B": 7,
              "Value #C": 8,
              "Value #D": 9,
              "Total kbps": 10,
              "Value #E": 11
            },
            "renameByName": {
              "mac": "MAC",
              "ip": "IP",
              "ipaddr": "IP",
              "hostname": "Hostname",
              "name": "Hostname",
              "ifname": "Radio",
              "Value #A": "Signal dBm",
              "Value #B": "Idle s",
              "Value #C": "RX kbps",
              "Value #D": "TX kbps",
              "Value #E": "Issue Score"
            }
          }
        }
      ],
      "type": "table"
    },
