        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_drop_total{job=\"openwrt-monitoring\",instance=\"$instance\",device!=\"lo\"}[5m])) + sum by (device) (rate(node_network_transmit_drop_total{job=\"openwrt-monitoring\",instance=\"$instance\",device!=\"lo\"}[5m]))",
          "legendFormat": "{{device}} Drops (pkt/s)",
          "refId": "A"
        }
      ],
      "title": "Interface Drops (5m, pkt/s)",
